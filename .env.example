# =============================================================================
# LLM Bench — Environment Variables
# =============================================================================
# Copy this file to .env (or docker-compose.env in production) and fill in
# your values.
#
#   cp .env.example .env
#
# Production requirements (docker-compose.yml will refuse to start without them):
#   - SECRET_KEY          — a strong, random string
#   - ADMIN_PASSWORD      — a strong, unique admin password
#
# All other variables have safe defaults.
# =============================================================================

# --- Mode --------------------------------------------------------------------
# "development" (default) or "production".
# In production the app refuses to start unless SECRET_KEY and ADMIN_PASSWORD
# are set to strong, non-default values, and the session cookie is marked Secure.
ENVIRONMENT=development

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/bench.db

# --- Auth --------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production

ADMIN_USERNAME=admin
# REQUIRED in production. Use a strong, unique password.
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@example.com

# Set to true to send the session cookie only over HTTPS (auto-enabled in production).
COOKIE_SECURE=false

# --- SSRF policy -------------------------------------------------------------
# By default, model base URLs that resolve to private/loopback/link-local
# addresses are blocked. Set to true to allow internal endpoints (e.g. a
# self-hosted model on a trusted LAN).
ALLOW_PRIVATE_ENDPOINTS=false

# --- OIDC (Keycloak) — optional ----------------------------------------------
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://keycloak:8080/realms/benchmark
OIDC_CLIENT_ID=llm-bench
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback

# --- Server binding ----------------------------------------------------------
# Defaults to localhost; set to 0.0.0.0 to expose on all interfaces.
HOST=127.0.0.1
PORT=8000

# --- CLI benchmark (benchmark.py) --------------------------------------------
OPENAI_BASE_URL=
OPENAI_KEY=
OPENAI_MODEL=unknown
OPENAI_MAX_TOKENS=4096
# Deterministic decoding for reproducible quality scores.
OPENAI_TEMPERATURE=0
# Optional integer seed for providers that support it.
OPENAI_SEED=

# =============================================================================
# Production-only — used by docker-compose.prod.yml (Traefik)
# =============================================================================
# DOMAIN=benchmark.example.com
# LETSENCRYPT_EMAIL=admin@example.com
# TRAEFIK_DASHBOARD_USER=admin
# TRAEFIK_DASHBOARD_PASS=<bcrypt hash, generate with `htpasswd -nbB user pass`>